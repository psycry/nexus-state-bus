[Unit]
Description=Digital Nomad LLC - Autonomous Lead Ingestion, Dossier & Notification Sweep
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/psycry/Projects/agent_smith
ExecStart=/bin/bash -lc 'docker start agent-smith-pgvector >/dev/null 2>&1 </dev/null || true; for i in $(seq 1 60); do docker exec agent-smith-pgvector pg_isready -U smith -d nomad_nexus_grid >/dev/null 2>&1 </dev/null && break; sleep 2; done; /home/psycry/Projects/agent_smith/engine/.venv/bin/python -m engine.ingest --ingest-all --top 10 --seed-anchors && /home/psycry/Projects/agent_smith/engine/.venv/bin/python -m engine.dossier --min-score 0.40 && /home/psycry/Projects/agent_smith/engine/.venv/bin/python -m engine.notify --min-score 0.40 && /home/psycry/Projects/agent_smith/scripts/push_state_bus.sh'
StandardOutput=append:/home/psycry/Projects/agent_smith/sweep.log
StandardError=append:/home/psycry/Projects/agent_smith/sweep.log
