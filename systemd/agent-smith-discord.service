[Unit]
Description=Agent Smith 24/7 Discord Async C2 Bridge (OCI Ampere A1)
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/agent_smith
ExecStart=/opt/agent_smith/target/release/discord
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
