[Unit]
Description=Agent Smith 24/7 OCI Mesh Executive & State Bus Sync Worker
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agent_smith
ExecStart=/usr/bin/git -C /home/opc/nexus-state-bus pull --ff-only origin main
ExecStartPost=/usr/bin/python3 -m engine.mesh_handoff --claim --node ampere-a1 --queue-path /home/opc/nexus-state-bus/memory_bus/mesh_handoffs.jsonl
StandardOutput=journal
StandardError=journal
